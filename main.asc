// Generic local test main for rotary_pos_emb_custom
// Usage: ./rotary_pos_emb_custom <dtype:0=f32,1=f16> <B> <S> <H> <D> <theta> <inPath> <posPath> <outPath> <coreNum>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include <cstring>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

#include "kernel.asc"

int main(int argc, char** argv)
{
    if (argc < 10) {
        fprintf(stderr, "usage: %s dtype B S H D theta inPath posPath outPath coreNum\n", argv[0]);
        return 2;
    }
    int32_t dtype = atoi(argv[1]);
    int64_t B = atoll(argv[2]);
    int64_t S = atoll(argv[3]);
    int64_t H = atoll(argv[4]);
    int64_t D = atoll(argv[5]);
    float theta = (float)atof(argv[6]);
    const char* inPath = argv[7];
    const char* posPath = argv[8];
    const char* outPath = argv[9];
    int64_t coreLimit = argc > 10 ? atoll(argv[10]) : 0;

    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    if (coreLimit > 0 && coreLimit < availableCoreNum) availableCoreNum = coreLimit;
    if (availableCoreNum <= 0) return 1;
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t xsz = B * S * H * D * (dtype == 1 ? 2 : 4);
    int64_t psz = B * S * 4;

    int64_t x_0_shape[] = {B, S, H, D};
    TensorInfo x_tensors[] = {{x_0_shape, 4, dtype}};
    TensorGroupInfo info_x = {x_tensors, 1};
    int64_t positions_0_shape[] = {B, S};
    TensorInfo positions_tensors[] = {{positions_0_shape, 2, 5}};
    TensorGroupInfo info_positions = {positions_tensors, 1};
    int64_t y_0_shape[] = {B, S, H, D};
    TensorInfo y_tensors[] = {{y_0_shape, 4, dtype}};
    TensorGroupInfo info_y = {y_tensors, 1};

    uint8_t *inputHost_x = nullptr, *inputDevice_x = nullptr;
    uint8_t *inputHost_positions = nullptr, *inputDevice_positions = nullptr;
    uint8_t *outputHost_y = nullptr, *outputDevice_y = nullptr;

    ACL_CHECK(aclrtMallocHost((void**)&inputHost_x, xsz));
    ACL_CHECK(aclrtMalloc((void**)&inputDevice_x, xsz, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile(inPath, xsz, inputHost_x, xsz));
    ACL_CHECK(aclrtMemcpy(inputDevice_x, xsz, inputHost_x, xsz, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void**)&inputHost_positions, psz));
    ACL_CHECK(aclrtMalloc((void**)&inputDevice_positions, psz, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile(posPath, psz, inputHost_positions, psz));
    ACL_CHECK(aclrtMemcpy(inputDevice_positions, psz, inputHost_positions, psz, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void**)&outputHost_y, xsz));
    ACL_CHECK(aclrtMalloc((void**)&outputDevice_y, xsz, ACL_MEM_MALLOC_HUGE_FIRST));

    run_kernel((GM_ADDR)inputDevice_x, info_x, (GM_ADDR)inputDevice_positions, info_positions,
               (GM_ADDR)outputDevice_y, info_y, availableCoreNum, stream, theta);
    auto sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 300000);
    if (sync_ret_ != 0) {
        fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", sync_ret_);
        return 1;
    }
    ACL_CHECK(aclrtMemcpy(outputHost_y, xsz, outputDevice_y, xsz, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile(outPath, outputHost_y, xsz));

    if (inputDevice_x) aclrtFree(inputDevice_x);
    if (inputHost_x) aclrtFreeHost(inputHost_x);
    if (inputDevice_positions) aclrtFree(inputDevice_positions);
    if (inputHost_positions) aclrtFreeHost(inputHost_positions);
    if (outputDevice_y) aclrtFree(outputDevice_y);
    if (outputHost_y) aclrtFreeHost(outputHost_y);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
