#include <cstdint>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

namespace {

constexpr int32_t MAX_HALF = 512;                 // max dim/2
constexpr uint32_t TILE_ELEM_CAP = 24576;         // max K*dim elements of one UB tile (↑ fewer head loops)
constexpr uint32_t COPY_ELEM_CAP = 65536;         // per DataCopy element cap
constexpr int32_t EVT_S_MTE3 = 0;
constexpr int32_t EVT_MTE3_S = 0;

// ---------- shared math constants ----------

// 2pi reduction chunks: each significand <= 9 bits so k*c is exact in fp32 for k < 2^15
constexpr float PI2_C0 = 6.28125f;
constexpr float PI2_C1 = 0.001934051513671875f;
constexpr float PI2_C2 = 1.255422830581665e-06f;
constexpr float PI2_C3 = 2.4283508537337184e-10f;
constexpr float PI2_C4 = 2.4868995751603507e-13f;
constexpr float INV_2PI = 0.159154936f;   // fp32(1/(2pi))
constexpr float NEG_PI = -3.141592741f;   // fp32(-pi)

// cos(x) = -Q(w^2), sin(x) = -w*P(w^2) with w = x - k*2pi - pi in [-pi, pi]
constexpr float COS_P0 = 1.000000000e+00f;
constexpr float COS_P1 = -4.999999106e-01f;
constexpr float COS_P2 = 4.166650400e-02f;
constexpr float COS_P3 = -1.388786943e-03f;
constexpr float COS_P4 = 2.477115049e-05f;
constexpr float COS_P5 = -2.709010403e-07f;
constexpr float COS_P6 = 1.728090671e-09f;

constexpr float SIN_P0 = 1.000000000e+00f;
constexpr float SIN_P1 = -1.666666567e-01f;
constexpr float SIN_P2 = 8.333322592e-03f;
constexpr float SIN_P3 = -1.984058472e-04f;
constexpr float SIN_P4 = 2.753684612e-06f;
constexpr float SIN_P5 = -2.473759508e-08f;
constexpr float SIN_P6 = 1.364185709e-10f;

// scalar sin/cos of x >= 0 (same reduction/polys as the vector path)
__aicore__ inline void ScalarSinCosPi(float x, float* sOut, float* cOut)
{
    float y = x * INV_2PI;
    int32_t n = (int32_t)y;
    if ((float)n > y) {
        n -= 1;
    }
    float kf = (float)n;
    float r = x - kf * PI2_C0;
    r = r - kf * PI2_C1;
    r = r - kf * PI2_C2;
    r = r - kf * PI2_C3;
    r = r - kf * PI2_C4;
    float w = r + NEG_PI;
    float t = w * w;
    float cacc = COS_P6;
    cacc = cacc * t + COS_P5;
    cacc = cacc * t + COS_P4;
    cacc = cacc * t + COS_P3;
    cacc = cacc * t + COS_P2;
    cacc = cacc * t + COS_P1;
    cacc = cacc * t + COS_P0;
    float sacc = SIN_P6;
    sacc = sacc * t + SIN_P5;
    sacc = sacc * t + SIN_P4;
    sacc = sacc * t + SIN_P3;
    sacc = sacc * t + SIN_P2;
    sacc = sacc * t + SIN_P1;
    sacc = sacc * t + SIN_P0;
    *cOut = -cacc;
    *sOut = -w * sacc;
}

// ============================================================================
// Vector fast path (requires dim % 16 == 0). Uses TPipe/TQue so all DMA/vector
// synchronization is generated by the framework (manual events are unreliable
// in direct-invocation kernels on this device).
// ============================================================================
template <typename T, bool FP16>
class KernelRopeVec {
public:
    __aicore__ inline KernelRopeVec() {}

    __aicore__ inline void Init(const __gm__ uint8_t* xBase, const __gm__ uint8_t* yBase,
                                const __gm__ uint8_t* posBase, const __gm__ float* invfGm,
                                int64_t rowStart, int64_t rowEnd, int32_t hNum, int32_t dim)
    {
        rowStart_ = rowStart;
        rowEnd_ = rowEnd;
        hNum_ = hNum;
        dim_ = dim;
        half_ = dim / 2;

        headElems_ = (int64_t)hNum * dim;
        xGm.SetGlobalBuffer((__gm__ T*)xBase);
        yGm.SetGlobalBuffer((__gm__ T*)yBase);
        pGm.SetGlobalBuffer((__gm__ int32_t*)posBase);
        invfGm_.SetGlobalBuffer((__gm__ float*)invfGm);

        int32_t kMax = (int32_t)(COPY_ELEM_CAP / dim);
        int32_t kByElem = (int32_t)(TILE_ELEM_CAP / dim);
        if (kByElem < kMax) kMax = kByElem;
        if (kMax < 1) kMax = 1;
        // Prefer multiple tiles when H is large so depth-2 DMA/compute can overlap.
        if (hNum > 16) {
            int32_t aim = (hNum + 3) / 4;  // ~4 tiles
            if (aim < 1) aim = 1;
            if (aim < kMax) kMax = aim;
        }
        K_ = kMax > hNum ? hNum : kMax;
        if (K_ < 1) K_ = 1;

        tileElems_ = K_ * dim;
        uint32_t tileBytes = (uint32_t)tileElems_ * (uint32_t)sizeof(T);
        uint32_t scratchBytes = (uint32_t)tileElems_ * (uint32_t)sizeof(float);

        // depth-2 queues: overlap next CopyIn with current Compute/CopyOut
        pipe_.InitBuffer(inXQ_, 2, tileBytes);
        pipe_.InitBuffer(outYQ_, 2, tileBytes);
        pipe_.InitBuffer(invfQ_, 1, (uint32_t)MAX_HALF * sizeof(float));
        pipe_.InitBuffer(xfB_, scratchBytes);          // fp32 staging when FP16
        pipe_.InitBuffer(yfB_, scratchBytes);          // fp32 result staging when FP16
        pipe_.InitBuffer(auxQ_, 1, 9u * (uint32_t)MAX_HALF * sizeof(float));
        trig_ = auxQ_.AllocTensor<float>();

        // trig scratch slices (7 * MAX_HALF floats)
        b0_ = trig_[0];
        b1_ = trig_[MAX_HALF];
        b2_ = trig_[2 * MAX_HALF];
        b3_ = trig_[3 * MAX_HALF];
        b4_ = trig_[4 * MAX_HALF];
        cB_ = trig_[5 * MAX_HALF];
        sB_ = trig_[6 * MAX_HALF];
        iBuf_ = trig_[8 * MAX_HALF].ReinterpretCast<int32_t>();

        // stage invf table once into queue buffer, then DeQue it before first use
        invLocal_ = invfQ_.AllocTensor<float>();
        DataCopy(invLocal_, invfGm_, (uint32_t)half_);
        invfQ_.EnQue(invLocal_);
        invLocal_ = invfQ_.DeQue<float>();
    }

    __aicore__ inline void Process()
    {
        for (int64_t r = rowStart_; r < rowEnd_; ++r) {
            int64_t rowOff = r * headElems_;
            // build head tile plan
            int32_t nTile = (hNum_ + K_ - 1) / K_;
            if (nTile < 1) continue;
            TrigRow(r);
            // tile 0 in
            {
                int32_t k = hNum_ < K_ ? hNum_ : K_;
                CopyIn(rowOff, k * dim_);
            }
            for (int32_t t = 0; t < nTile; ++t) {
                int32_t h0 = t * K_;
                int32_t k = hNum_ - h0;
                if (k > K_) k = K_;
                int32_t cnt = k * dim_;
                int64_t gOff = rowOff + (int64_t)h0 * dim_;
                // prefetch next tile while computing current
                if (t + 1 < nTile) {
                    int32_t h1 = (t + 1) * K_;
                    int32_t k1 = hNum_ - h1;
                    if (k1 > K_) k1 = K_;
                    CopyIn(rowOff + (int64_t)h1 * dim_, k1 * dim_);
                }
                Compute(cnt);
                CopyOut(gOff, cnt);
            }
        }
    }

private:
    __aicore__ inline void TrigRow(int64_t r)
    {
        int32_t pRaw = pGm.GetValue((uint64_t)r);
        float p = (float)pRaw;
        int32_t half = half_;

        // angles = p * invf ; k = floor(angles * inv2pi)
        Muls(b0_, invLocal_, p, half);
        Muls(b1_, b0_, INV_2PI, half);
        Cast<int32_t, float>(iBuf_, b1_, RoundMode::CAST_FLOOR, (uint32_t)half);
        Cast<float, int32_t>(b1_, iBuf_, RoundMode::CAST_NONE, (uint32_t)half);
        // r = x - k*2pi (5 exact chunks)
        Muls(b2_, b1_, PI2_C0, half);
        Sub(b0_, b0_, b2_, half);
        Muls(b2_, b1_, PI2_C1, half);
        Sub(b0_, b0_, b2_, half);
        Muls(b2_, b1_, PI2_C2, half);
        Sub(b0_, b0_, b2_, half);
        Muls(b2_, b1_, PI2_C3, half);
        Sub(b0_, b0_, b2_, half);
        Muls(b2_, b1_, PI2_C4, half);
        Sub(b0_, b0_, b2_, half);
        // w = r - pi ; t = w*w
        Adds(b0_, b0_, NEG_PI, half);
        Mul(b2_, b0_, b0_, half);

        // cos(x) = -Q(t)
        Muls(b3_, b2_, COS_P6, half);
        Adds(b3_, b3_, COS_P5, half);
        Mul(b3_, b3_, b2_, half);
        Adds(b3_, b3_, COS_P4, half);
        Mul(b3_, b3_, b2_, half);
        Adds(b3_, b3_, COS_P3, half);
        Mul(b3_, b3_, b2_, half);
        Adds(b3_, b3_, COS_P2, half);
        Mul(b3_, b3_, b2_, half);
        Adds(b3_, b3_, COS_P1, half);
        Mul(b3_, b3_, b2_, half);
        Adds(b3_, b3_, COS_P0, half);
        Muls(cB_, b3_, -1.0f, half);

        // sin(x) = -w*P(t)
        Muls(b4_, b2_, SIN_P6, half);
        Adds(b4_, b4_, SIN_P5, half);
        Mul(b4_, b4_, b2_, half);
        Adds(b4_, b4_, SIN_P4, half);
        Mul(b4_, b4_, b2_, half);
        Adds(b4_, b4_, SIN_P3, half);
        Mul(b4_, b4_, b2_, half);
        Adds(b4_, b4_, SIN_P2, half);
        Mul(b4_, b4_, b2_, half);
        Adds(b4_, b4_, SIN_P1, half);
        Mul(b4_, b4_, b2_, half);
        Adds(b4_, b4_, SIN_P0, half);
        Mul(b4_, b0_, b4_, half);  // w * P
        Muls(sB_, b4_, -1.0f, half);
    }

    __aicore__ inline void CopyIn(int64_t gOff, int32_t cnt)
    {
        xLocal_ = inXQ_.AllocTensor<T>();
        DataCopy(xLocal_, xGm[gOff], (uint32_t)cnt);
        inXQ_.EnQue(xLocal_);
    }

    __aicore__ inline void Compute(int32_t cnt)
    {
        xLocal_ = inXQ_.DeQue<T>();
        yLocal_ = outYQ_.AllocTensor<T>();
        int32_t dim = dim_;
        int32_t halfE = half_;
        // Process heads in pairs when possible to cut loop overhead slightly.
        int32_t nHead = cnt / dim;

        if constexpr (FP16) {
            LocalTensor<float> xf = xfB_.template Get<float>();
            Cast(xf, xLocal_, RoundMode::CAST_NONE, (uint32_t)cnt);
            LocalTensor<float> yf = yfB_.template Get<float>();
            int32_t base = 0;
            int32_t hh = 0;
            for (; hh + 1 < nHead; hh += 2, base += 2 * dim) {
                // head 0
                Mul(b3_, xf[base], cB_, halfE);
                Mul(b4_, xf[base + halfE], sB_, halfE);
                Sub(yf[base], b3_, b4_, halfE);
                Mul(b3_, xf[base + halfE], cB_, halfE);
                Mul(b4_, xf[base], sB_, halfE);
                Add(yf[base + halfE], b3_, b4_, halfE);
                // head 1
                int32_t b2 = base + dim;
                Mul(b3_, xf[b2], cB_, halfE);
                Mul(b4_, xf[b2 + halfE], sB_, halfE);
                Sub(yf[b2], b3_, b4_, halfE);
                Mul(b3_, xf[b2 + halfE], cB_, halfE);
                Mul(b4_, xf[b2], sB_, halfE);
                Add(yf[b2 + halfE], b3_, b4_, halfE);
            }
            for (; hh < nHead; ++hh, base += dim) {
                Mul(b3_, xf[base], cB_, halfE);
                Mul(b4_, xf[base + halfE], sB_, halfE);
                Sub(yf[base], b3_, b4_, halfE);
                Mul(b3_, xf[base + halfE], cB_, halfE);
                Mul(b4_, xf[base], sB_, halfE);
                Add(yf[base + halfE], b3_, b4_, halfE);
            }
            Cast(yLocal_, yf, RoundMode::CAST_ROUND, (uint32_t)cnt);
        } else {
            int32_t base = 0;
            int32_t hh = 0;
            for (; hh + 1 < nHead; hh += 2, base += 2 * dim) {
                Mul(b3_, xLocal_[base], cB_, halfE);
                Mul(b4_, xLocal_[base + halfE], sB_, halfE);
                Sub(yLocal_[base], b3_, b4_, halfE);
                Mul(b3_, xLocal_[base + halfE], cB_, halfE);
                Mul(b4_, xLocal_[base], sB_, halfE);
                Add(yLocal_[base + halfE], b3_, b4_, halfE);
                int32_t b2 = base + dim;
                Mul(b3_, xLocal_[b2], cB_, halfE);
                Mul(b4_, xLocal_[b2 + halfE], sB_, halfE);
                Sub(yLocal_[b2], b3_, b4_, halfE);
                Mul(b3_, xLocal_[b2 + halfE], cB_, halfE);
                Mul(b4_, xLocal_[b2], sB_, halfE);
                Add(yLocal_[b2 + halfE], b3_, b4_, halfE);
            }
            for (; hh < nHead; ++hh, base += dim) {
                Mul(b3_, xLocal_[base], cB_, halfE);
                Mul(b4_, xLocal_[base + halfE], sB_, halfE);
                Sub(yLocal_[base], b3_, b4_, halfE);
                Mul(b3_, xLocal_[base + halfE], cB_, halfE);
                Mul(b4_, xLocal_[base], sB_, halfE);
                Add(yLocal_[base + halfE], b3_, b4_, halfE);
            }
        }
        outYQ_.EnQue(yLocal_);
        inXQ_.FreeTensor(xLocal_);
    }

    __aicore__ inline void CopyOut(int64_t gOff, int32_t cnt)
    {
        yLocal_ = outYQ_.DeQue<T>();
        DataCopy(yGm[gOff], yLocal_, (uint32_t)cnt);
        outYQ_.FreeTensor(yLocal_);
    }

private:
    TPipe pipe_;
    TQue<QuePosition::VECIN, 2> inXQ_;
    TQue<QuePosition::VECOUT, 2> outYQ_;
    TQue<QuePosition::VECIN, 1> invfQ_;
    TBuf<QuePosition::VECCALC> xfB_;
    TBuf<QuePosition::VECCALC> yfB_;
    TQue<QuePosition::VECIN, 1> auxQ_;
    LocalTensor<float> trig_;
    LocalTensor<float> b0_;
    LocalTensor<float> b1_;
    LocalTensor<float> b2_;
    LocalTensor<float> b3_;
    LocalTensor<float> b4_;
    LocalTensor<float> cB_;
    LocalTensor<float> sB_;
    LocalTensor<float> invLocal_;
    LocalTensor<T> xLocal_;
    LocalTensor<T> yLocal_;
    LocalTensor<int32_t> iBuf_;
    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<int32_t> pGm;
    GlobalTensor<float> invfGm_;
    int64_t rowStart_;
    int64_t rowEnd_;
    int32_t hNum_;
    int32_t dim_;
    int32_t half_;
    int32_t K_;
    int32_t tileElems_;
    int64_t headElems_;
};



// ============================================================================
// Reordered-layout path for arbitrary dim: half segments padded to 32B slots.
// xa layout per row r: slot k = r*H*2*padHalf + k*padHalf, k=2h+{0,1}; first
// `half` elements of each slot carry data.
// ============================================================================
template <typename T, bool FP16>
class KernelRopeReorder {
public:
    __aicore__ inline KernelRopeReorder() {}

    __aicore__ inline void Init(const __gm__ uint8_t* xBase, const __gm__ uint8_t* yBase,
                                const __gm__ uint8_t* posBase, const __gm__ float* invfGm,
                                int64_t rowStart, int64_t rowEnd, int32_t hNum,
                                int32_t half, int32_t padHalf)
    {
        rowStart_ = rowStart;
        rowEnd_ = rowEnd;
        hNum_ = hNum;
        half_ = half;
        padHalf_ = padHalf;
        rowSlots_ = (int64_t)hNum * 2 * padHalf;
        alignHalf_ = ((half + 7) / 8) * 8;
        if (alignHalf_ > MAX_HALF) alignHalf_ = MAX_HALF;
        xGm.SetGlobalBuffer((__gm__ T*)xBase);
        yGm.SetGlobalBuffer((__gm__ T*)yBase);
        pGm.SetGlobalBuffer((__gm__ int32_t*)posBase);
        invfGm_.SetGlobalBuffer((__gm__ float*)invfGm);

        int32_t kBySlots = (int32_t)(TILE_ELEM_CAP / (2 * padHalf));
        if (kBySlots < 1) kBySlots = 1;
        K_ = kBySlots > hNum ? hNum : kBySlots;
        if (K_ < 1) K_ = 1;
        tileElems_ = K_ * 2 * padHalf;

        uint32_t tileBytes = (uint32_t)tileElems_ * sizeof(T);
        pipe_.InitBuffer(inXQ_, 1, tileBytes);
        pipe_.InitBuffer(outYQ_, 1, tileBytes);
        pipe_.InitBuffer(invfQ_, 1, (uint32_t)MAX_HALF * sizeof(float));
        pipe_.InitBuffer(auxQ_, 1, 9u * (uint32_t)MAX_HALF * sizeof(float));
        if constexpr (FP16) {
            pipe_.InitBuffer(xfB_, (uint32_t)tileElems_ * sizeof(float));
            pipe_.InitBuffer(yfB_, (uint32_t)tileElems_ * sizeof(float));
        }
        trig_ = auxQ_.AllocTensor<float>();
        b0_ = trig_[0];
        b1_ = trig_[MAX_HALF];
        b2_ = trig_[2 * MAX_HALF];
        b3_ = trig_[3 * MAX_HALF];
        b4_ = trig_[4 * MAX_HALF];
        cB_ = trig_[5 * MAX_HALF];
        sB_ = trig_[6 * MAX_HALF];
        iBuf_ = trig_[8 * MAX_HALF].ReinterpretCast<int32_t>();

        invLocal_ = invfQ_.AllocTensor<float>();
        DataCopy(invLocal_, invfGm_, (uint32_t)alignHalf_);
        invfQ_.EnQue(invLocal_);
        invLocal_ = invfQ_.DeQue<float>();
    }

    __aicore__ inline void Process()
    {
        for (int64_t r = rowStart_; r < rowEnd_; ++r) {
            int64_t slotBase = r * rowSlots_;
            int32_t k0 = hNum_ > K_ ? K_ : hNum_;
            CopyIn(slotBase, k0 * 2 * padHalf_);  // prefetch first tile under trig
            TrigRow(r);
            int32_t h = 0;
            int32_t first = 1;
            while (h < hNum_) {
                int32_t k = hNum_ - h;
                if (k > K_) k = K_;
                int64_t off = slotBase + (int64_t)h * 2 * padHalf_;
                int32_t cnt = k * 2 * padHalf_;
                if (!first) {
                    CopyIn(off, cnt);
                }
                Compute(cnt);
                CopyOut(off, cnt);
                h += k;
                first = 0;
            }
        }
    }

private:
    __aicore__ inline void TrigRow(int64_t r)
    {
        int32_t p = pGm.GetValue((uint64_t)r);
        float pf = (float)p;
        int32_t half = alignHalf_;
        Muls(b0_, invLocal_, pf, half);
        Muls(b1_, b0_, INV_2PI, half);
        Cast<int32_t, float>(iBuf_, b1_, RoundMode::CAST_FLOOR, (uint32_t)half);
        Cast<float, int32_t>(b1_, iBuf_, RoundMode::CAST_NONE, (uint32_t)half);
        Muls(b2_, b1_, PI2_C0, half);
        Sub(b0_, b0_, b2_, half);
        Muls(b2_, b1_, PI2_C1, half);
        Sub(b0_, b0_, b2_, half);
        Muls(b2_, b1_, PI2_C2, half);
        Sub(b0_, b0_, b2_, half);
        Muls(b2_, b1_, PI2_C3, half);
        Sub(b0_, b0_, b2_, half);
        Muls(b2_, b1_, PI2_C4, half);
        Sub(b0_, b0_, b2_, half);
        Adds(b0_, b0_, NEG_PI, half);
        Mul(b2_, b0_, b0_, half);

        Muls(b3_, b2_, COS_P6, half);
        Adds(b3_, b3_, COS_P5, half);
        Mul(b3_, b3_, b2_, half);
        Adds(b3_, b3_, COS_P4, half);
        Mul(b3_, b3_, b2_, half);
        Adds(b3_, b3_, COS_P3, half);
        Mul(b3_, b3_, b2_, half);
        Adds(b3_, b3_, COS_P2, half);
        Mul(b3_, b3_, b2_, half);
        Adds(b3_, b3_, COS_P1, half);
        Mul(b3_, b3_, b2_, half);
        Adds(b3_, b3_, COS_P0, half);
        Muls(cB_, b3_, -1.0f, half);

        Muls(b4_, b2_, SIN_P6, half);
        Adds(b4_, b4_, SIN_P5, half);
        Mul(b4_, b4_, b2_, half);
        Adds(b4_, b4_, SIN_P4, half);
        Mul(b4_, b4_, b2_, half);
        Adds(b4_, b4_, SIN_P3, half);
        Mul(b4_, b4_, b2_, half);
        Adds(b4_, b4_, SIN_P2, half);
        Mul(b4_, b4_, b2_, half);
        Adds(b4_, b4_, SIN_P1, half);
        Mul(b4_, b4_, b2_, half);
        Adds(b4_, b4_, SIN_P0, half);
        Mul(b4_, b0_, b4_, half);
        Muls(sB_, b4_, -1.0f, half);
    }

    __aicore__ inline void CopyIn(int64_t off, int32_t cnt)
    {
        xLocal_ = inXQ_.AllocTensor<T>();
        DataCopy(xLocal_, xGm[off], (uint32_t)cnt);
        inXQ_.EnQue(xLocal_);
    }

    __aicore__ inline void Compute(int32_t cnt)
    {
        xLocal_ = inXQ_.DeQue<T>();
        yLocal_ = outYQ_.AllocTensor<T>();
        int32_t half = alignHalf_;
        int32_t padHalf = padHalf_;
        if constexpr (FP16) {
            LocalTensor<float> xf = xfB_.template Get<float>();
            Cast(xf, xLocal_, RoundMode::CAST_NONE, (uint32_t)cnt);
            LocalTensor<float> yf = yfB_.template Get<float>();
            int32_t nHead = cnt / (2 * padHalf);
            for (int32_t hh = 0, base = 0; hh < nHead; ++hh, base += 2 * padHalf) {
                Mul(b3_, xf[base], cB_, half);
                Mul(b4_, xf[base + padHalf], sB_, half);
                Sub(yf[base], b3_, b4_, half);
                Mul(b3_, xf[base + padHalf], cB_, half);
                Mul(b4_, xf[base], sB_, half);
                Add(yf[base + padHalf], b3_, b4_, half);
            }
            Cast(yLocal_, yf, RoundMode::CAST_ROUND, (uint32_t)cnt);
        } else {
            int32_t nHead = cnt / (2 * padHalf);
            for (int32_t hh = 0, base = 0; hh < nHead; ++hh, base += 2 * padHalf) {
                Mul(b3_, xLocal_[base], cB_, half);
                Mul(b4_, xLocal_[base + padHalf], sB_, half);
                Sub(yLocal_[base], b3_, b4_, half);
                Mul(b3_, xLocal_[base + padHalf], cB_, half);
                Mul(b4_, xLocal_[base], sB_, half);
                Add(yLocal_[base + padHalf], b3_, b4_, half);
            }
        }
        outYQ_.EnQue(yLocal_);
        inXQ_.FreeTensor(xLocal_);
    }

    __aicore__ inline void CopyOut(int64_t off, int32_t cnt)
    {
        yLocal_ = outYQ_.DeQue<T>();
        DataCopy(yGm[off], yLocal_, (uint32_t)cnt);
        outYQ_.FreeTensor(yLocal_);
    }

private:
    TPipe pipe_;
    TQue<QuePosition::VECIN, 1> inXQ_;
    TQue<QuePosition::VECOUT, 1> outYQ_;
    TQue<QuePosition::VECIN, 1> invfQ_;
    TQue<QuePosition::VECIN, 1> auxQ_;
    TBuf<QuePosition::VECCALC> xfB_;
    TBuf<QuePosition::VECCALC> yfB_;
    LocalTensor<float> trig_;
    LocalTensor<float> b0_, b1_, b2_, b3_, b4_, cB_, sB_;
    LocalTensor<float> invLocal_;
    LocalTensor<T> xLocal_, yLocal_;
    LocalTensor<int32_t> iBuf_;
    GlobalTensor<T> xGm, yGm;
    GlobalTensor<int32_t> pGm;
    GlobalTensor<float> invfGm_;
    int64_t rowStart_, rowEnd_;
    int32_t hNum_, half_, padHalf_, alignHalf_, K_, tileElems_;
    int64_t rowSlots_;
};

}  // namespace

extern "C" __global__ __vector__ void rotary_pos_emb_vec_kernel(
    __gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* positions, __gm__ float* invf,
    int64_t rows, int32_t hNum, int32_t dim, int32_t dcode)
{
    InitSocState();
    if (rows <= 0) return;
    uint32_t blockIdx = GetBlockIdx();
    uint32_t blockNum = GetBlockNum();
    int64_t rStep = (rows + blockNum - 1) / blockNum;
    int64_t r0 = (int64_t)blockIdx * rStep;
    int64_t r1 = r0 + rStep;
    if (r1 > rows) r1 = rows;
    if (r0 >= rows) return;
    if (dcode == 0) {
        KernelRopeVec<float, false> op;
        op.Init(x, y, positions, invf, r0, r1, hNum, dim);
        op.Process();
    } else {
        KernelRopeVec<half, true> op;
        op.Init(x, y, positions, invf, r0, r1, hNum, dim);
        op.Process();
    }
}



extern "C" __global__ __vector__ void rotary_pos_emb_reorder_kernel(
    __gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* positions, __gm__ float* invf,
    int64_t rows, int32_t hNum, int32_t halfD, int32_t padHalfD, int32_t dcode)
{
    InitSocState();
    if (rows <= 0) return;
    uint32_t blockIdx = GetBlockIdx();
    uint32_t blockNum = GetBlockNum();
    int64_t rStep = (rows + blockNum - 1) / blockNum;
    int64_t r0 = (int64_t)blockIdx * rStep;
    int64_t r1 = r0 + rStep;
    if (r1 > rows) r1 = rows;
    if (r0 >= rows) return;
    if (dcode == 0) {
        KernelRopeReorder<float, false> op;
        op.Init(x, y, positions, invf, r0, r1, hNum, halfD, padHalfD);
        op.Process();
    } else {
        KernelRopeReorder<half, true> op;
        op.Init(x, y, positions, invf, r0, r1, hNum, halfD, padHalfD);
        op.Process();
    }
}

extern "C" __global__ __vector__ void rope_copy_kernel(__gm__ uint8_t* x, __gm__ uint8_t* y,
    int64_t elems, int32_t es)
{
    InitSocState();
    if (elems <= 0) return;
    uint32_t blockIdx = GetBlockIdx();
    uint32_t blockNum = GetBlockNum();
    int64_t step = (elems + blockNum - 1) / blockNum;
    int64_t g0 = (int64_t)blockIdx * step;
    int64_t g1 = g0 + step;
    if (g1 > elems) g1 = elems;
    if (g0 >= elems) return;
    if (es == 4) {
        const __gm__ int32_t* src = (const __gm__ int32_t*)x;
        __gm__ int32_t* dst = (__gm__ int32_t*)y;
        for (int64_t i = g0; i < g1; ++i) dst[i] = src[i];
    } else {
        const __gm__ int16_t* src = (const __gm__ int16_t*)x;
        __gm__ int16_t* dst = (__gm__ int16_t*)y;
        for (int64_t i = g0; i < g1; ++i) dst[i] = src[i];
    }
}

// host reorder helpers --------------------------------------------------------
#include <cstring>

template <typename T>
static inline void GatherSlots(const T* src, T* dst, int64_t rows, int32_t H,
                               int32_t dim, int32_t half, int32_t padHalf)
{
    const size_t segBytes = (size_t)half * sizeof(T);
    const int64_t LE = (int64_t)H * dim;
    const int64_t rowSlots = (int64_t)H * 2 * padHalf;
    for (int64_t r = 0; r < rows; ++r) {
        const T* row = src + r * LE;
        T* drow = dst + r * rowSlots;
        for (int32_t h = 0; h < H; ++h) {
            const T* hd = row + (int64_t)h * dim;
            T* d1 = drow + (int64_t)h * 2 * padHalf;
            std::memcpy(d1, hd, segBytes);
            std::memcpy(d1 + padHalf, hd + half, segBytes);
        }
    }
}

template <typename T>
static inline void ScatterSlots(const T* src, T* dst, int64_t rows, int32_t H,
                                int32_t dim, int32_t half, int32_t padHalf)
{
    const size_t segBytes = (size_t)half * sizeof(T);
    const int64_t LE = (int64_t)H * dim;
    const int64_t rowSlots = (int64_t)H * 2 * padHalf;
    for (int64_t r = 0; r < rows; ++r) {
        const T* srow = src + r * rowSlots;
        T* row = dst + r * LE;
        for (int32_t h = 0; h < H; ++h) {
            const T* s1 = srow + (int64_t)h * 2 * padHalf;
            T* hd = row + (int64_t)h * dim;
            std::memcpy(hd, s1, segBytes);
            std::memcpy(hd + half, s1 + padHalf, segBytes);
        }
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR positions,
                           const TensorGroupInfo& info_positions, GM_ADDR y,
                           const TensorGroupInfo& info_y, int64_t availableCoreNum,
                           aclrtStream stream, float theta)
{
    const TensorInfo& xi = info_x.tensors[0];
    int32_t ndim = (int32_t)xi.numDims;
    int32_t B = (int32_t)xi.shape[0];
    int32_t S = (ndim >= 2) ? (int32_t)xi.shape[1] : 1;
    int32_t H = (ndim >= 3) ? (int32_t)xi.shape[2] : 1;
    int32_t dim = (int32_t)xi.shape[ndim - 1];
    int32_t dcode = xi.dtype;
    int32_t es = (dcode == 0) ? 4 : 2;
    int64_t rows = (int64_t)B * S;
    int64_t blockNum = rows;
    if (blockNum > availableCoreNum) blockNum = availableCoreNum;
    if (blockNum < 1) blockNum = 1;

    // invf table: upload only when (theta, dim) changes
    static void* invfDev = nullptr;
    static float cachedTheta = -1.0f;
    static int32_t cachedDim = -1;
    if (invfDev == nullptr) {
        aclrtMalloc(&invfDev, 512 * (int32_t)sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    }
    int32_t half = dim / 2;
    int32_t invfCount = ((half + 7) / 8) * 8;
    if (invfCount > 512) invfCount = 512;
    if (theta != cachedTheta || dim != cachedDim) {
        float invfHost[512];
        for (int32_t j = 0; j < invfCount; ++j) {
            float e = (float)(2 * j) / (float)dim;
            invfHost[j] = 1.0f / ::powf(theta, e);
        }
        aclrtMemcpy(invfDev, invfCount * (int32_t)sizeof(float), invfHost,
                    invfCount * (int32_t)sizeof(float),
                    ACL_MEMCPY_HOST_TO_DEVICE);
        cachedTheta = theta;
        cachedDim = dim;
    }

    if ((dim % 16) == 0) {
        rotary_pos_emb_vec_kernel<<<blockNum, nullptr, stream>>>(x, y, positions,
            (__gm__ float*)invfDev, rows, H, dim, dcode);
        return;
    }

    // reordered half-slot layout for arbitrary dim
    int32_t padHalf = (half * es + 31) / 32 * (32 / es);
    int64_t inBytes = rows * (int64_t)H * dim * es;
    int64_t slotBytes = rows * (int64_t)H * 2 * padHalf * es;
    if (slotBytes < inBytes) slotBytes = inBytes;

    static void* xaDev = nullptr;
    static void* yaDev = nullptr;
    static void* hxHost = nullptr;
    static void* hsHost = nullptr;
    static void* hyHost = nullptr;
    static int64_t cached = 0;
    if (slotBytes > cached) {
        if (xaDev) {
            aclrtFree(xaDev); aclrtFree(yaDev);
            aclrtFreeHost(hxHost); aclrtFreeHost(hsHost); aclrtFreeHost(hyHost);
        }
        aclrtMalloc(&xaDev, slotBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(&yaDev, slotBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMallocHost(&hxHost, slotBytes);
        aclrtMallocHost(&hsHost, slotBytes);
        aclrtMallocHost(&hyHost, slotBytes);
        cached = slotBytes;
    }

    aclrtMemcpy(hxHost, inBytes, x, inBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    if (dcode == 0) {
        GatherSlots<float>((const float*)hxHost, (float*)hsHost, rows, H, dim, half, padHalf);
    } else {
        GatherSlots<uint16_t>((const uint16_t*)hxHost, (uint16_t*)hsHost, rows, H, dim, half, padHalf);
    }
    aclrtMemcpy(xaDev, slotBytes, hsHost, slotBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    rotary_pos_emb_reorder_kernel<<<blockNum, nullptr, stream>>>((__gm__ uint8_t*)xaDev,
        (__gm__ uint8_t*)yaDev, positions, (__gm__ float*)invfDev, rows, H, half, padHalf, dcode);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(hxHost, slotBytes, yaDev, slotBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    if (dcode == 0) {
        ScatterSlots<float>((const float*)hxHost, (float*)hyHost, rows, H, dim, half, padHalf);
    } else {
        ScatterSlots<uint16_t>((const uint16_t*)hxHost, (uint16_t*)hyHost, rows, H, dim, half, padHalf);
    }
    aclrtMemcpy((void*)y, inBytes, hyHost, inBytes, ACL_MEMCPY_HOST_TO_DEVICE);
}
